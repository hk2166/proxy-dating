# Required
ANTHROPIC_API_KEY=
APIFY_TOKEN=

# Optional: models (default claude-opus-5-5 for both)
# ANALYSIS_MODEL=claude-opus-5-5
# DATE_MODEL=claude-opus-5-5
# LLM_CONCURRENCY=16

# Optional: persistence for people added live (Upstash / Vercel KV). Without it,
# live additions are stored in data/live/ locally (or /tmp on Vercel).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
