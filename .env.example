# Scraping (required)
APIFY_TOKEN=

# LLM: every call walks the chain cheapest-first; set any keys you have (comma-separate multiple keys)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=                  # also used for date audio (gpt-4o-mini-tts)
ANTHROPIC_API_KEY=
