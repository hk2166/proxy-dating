# Scraping (required)
APIFY_TOKEN=

# LLM: set ONE of these. LLM_PROVIDER picks explicitly; otherwise the first key present wins.
OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_PROVIDER=openai            # openai | deepseek
# OPENAI_MODEL=gpt-5.4
# ANALYSIS_MODEL=                # override per stage
# DATE_MODEL=
# LLM_CONCURRENCY=16

# Optional: persistence for people added live (Upstash / Vercel KV). Without it,
# live additions are stored in data/live/ locally (or /tmp on Vercel).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# LIVE_DAILY_LIMIT=40            # cost guard: new people per day
